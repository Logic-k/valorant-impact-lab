VALORANT_DATA_PROVIDER=henrik
HENRIKDEV_API_KEY=
HENRIKDEV_BASE_URL=https://api.henrikdev.xyz

# Round decision engine: rules (default) | jev | jev-shadow
ANALYSIS_ENGINE=rules
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
# Free via Vercel AI Gateway (promo until 2026-09-25):
#   TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
#   TYPESAFE_API_KEY=<AI_GATEWAY_API_KEY or VERCEL_OIDC_TOKEN>
#   TYPESAFE_MODEL=typesafe-ai/jev
DECISION_MAX_ROUNDS=40
DECISION_CONCURRENCY=4
